# ── Database (Neon, EU region: eu-west-1) ────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/agora?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.eu-west-1.aws.neon.tech/agora?sslmode=require

# ── Auth (Clerk, EU data residency tenant) ───────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Webhook signing secret (Clerk Dashboard → Webhooks → your endpoint). Used by verifyWebhook.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# ── AI — AWS Bedrock (Frankfurt, eu-central-1) ───────────────────────────────
AWS_BEDROCK_REGION=eu-central-1
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
# Must be the `eu.` INFERENCE PROFILE id, not the bare foundation-model id.
# Bedrock rejects the bare id outright: "Invocation of model ID
# anthropic.claude-haiku-4-5-... with on-demand throughput isn't supported.
# Retry your request with the ID or ARN of an inference profile."
# (Verified against eu-central-1 on 2026-08-06.)
CLAUDE_SONNET_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
CLAUDE_HAIKU_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Cohere embeddings (Agent 3 ingestion) — multilingual v3, 1024-dim, EU Bedrock
COHERE_EMBED_MODEL_ID=cohere.embed-multilingual-v3

# ── Redis / Queue (Upstash, EU region) ──────────────────────────────────────
REDIS_URL=rediss://default:REPLACE_ME@eu1-xxxx.upstash.io:6380
UPSTASH_REDIS_REST_URL=https://eu1-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── Object Storage (Scaleway, fr-par Paris) ──────────────────────────────────
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=agora-jobs-docs
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

# ── Error Tracking (Sentry, EU region) ──────────────────────────────────────
SENTRY_DSN=https://REPLACE_ME@oXXXXX.ingest.de.sentry.io/REPLACE_ME

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Security (added by the 2026-08-06 security review) ───────────────────────
# Field encryption for resumes.content — see docs/Security/FIELD-ENCRYPTION.md.
# OFF by default. Turning it on without AWS_KMS_KEY_ID set will fail every resume write.
FIELD_ENCRYPTION_ENABLED=false
AWS_KMS_REGION=eu-central-1
AWS_KMS_KEY_ID=

# Direct (non-pooled) Neon endpoint. Required by packages/db/src/rls.ts: session-level
# state is not safe through a transaction-mode pooler.
# DATABASE_URL_UNPOOLED is already listed above — keep both set once RLS stage 2 lands.

# Rate limiting uses REDIS_URL (already listed above). Note: the AI limits fail CLOSED —
# if Redis is unreachable, AI endpoints return 429 rather than leaving Bedrock spend
# unmetered. See apps/web/src/server/lib/rate-limit.ts.

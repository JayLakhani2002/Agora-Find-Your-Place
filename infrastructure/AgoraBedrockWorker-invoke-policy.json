{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnyBedrockCallOutsideTheEU",
      "Effect": "Deny",
      "Action": "bedrock:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "eu-central-1",
            "eu-west-1",
            "eu-west-3",
            "eu-north-1",
            "eu-south-1",
            "eu-south-2"
          ]
        }
      }
    },
    {
      "Sid": "InvokeAnthropicAndCohereInEuOnly",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-north-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-1::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-south-2::foundation-model/anthropic.claude-*",
        "arn:aws:bedrock:eu-central-1::foundation-model/cohere.embed-*",
        "arn:aws:bedrock:eu-central-1:328559741463:inference-profile/eu.anthropic.claude-*"
      ]
    }
  ]
}

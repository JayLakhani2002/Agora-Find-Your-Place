# Agora marketing website — environment variables

# Render the Why It Wins stats row ("{{N}} beta users …"). Leave unset until
# real numbers exist — the values in en.ts are placeholders by design.
# SHOW_STATS=true

# Waitlist signups forward here as JSON {email, ts, source}. If unset, the
# /api/waitlist route logs a loud warning and does NOT persist emails.
# WAITLIST_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# Stage 2 — Ari chat (POST /api/ari, streaming). Server-only.
# ANTHROPIC_API_KEY=sk-ant-...
